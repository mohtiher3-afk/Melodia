diff --git a/app/src/test/java/com/example/domain/AudioAlignmentTest.kt b/app/src/test/java/com/example/domain/AudioAlignmentTest.kt
new file mode 100644
index 0000000..c0b134d
--- /dev/null
+++ b/app/src/test/java/com/example/domain/AudioAlignmentTest.kt
@@ -0,0 +1,184 @@
+package com.example.domain
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * Host-side tests for the PCM conversion and lyric-alignment helpers in [LocalWhisperEngine].
+ * They run on the JVM (no Android APIs), so they are fast and need no emulator.
+ */
+class AudioAlignmentTest {
+
+    // --- downmixToMono -------------------------------------------------------
+
+    @Test
+    fun downmixToMono_averagesStereoChannels() {
+        val stereo = floatArrayOf(1f, 0f, 0.5f, 0.5f, -1f, 1f)
+        val mono = downmixToMono(stereo, channels = 2)
+        assertEquals(listOf(0.5f, 0.5f, 0f), mono.toList())
+    }
+
+    @Test
+    fun downmixToMono_leavesMonoUntouched() {
+        val input = floatArrayOf(0.1f, 0.2f)
+        assertEquals(input.toList(), downmixToMono(input, channels = 1).toList())
+    }
+
+    // --- resampling ----------------------------------------------------------
+
+    @Test
+    fun resampleLinear_downsamplesByThree() {
+        val ramp = FloatArray(48) { it.toFloat() }
+        val out = resampleLinear(ramp, srcRate = 48_000, dstRate = 16_000)
+        assertEquals(16, out.size)
+        assertEquals(listOf(0f, 3f, 6f, 9f, 12f, 15f), out.take(6))
+    }
+
+    @Test
+    fun resampleLinear_upsamplesByTwoWithInterpolation() {
+        val out = resampleLinear(floatArrayOf(0f, 1f, 2f, 3f), srcRate = 8_000, dstRate = 16_000)
+        assertEquals(listOf(0f, 0.5f, 1f, 1.5f, 2f, 2.5f), out.toList())
+    }
+
+    @Test
+    fun resampleLinear_keepsDurationForCommonRates() {
+        // One second of audio must stay (about) one second at 16 kHz - the old decoder
+        // reported 44.1 kHz stereo as ~5.5x too long.
+        assertEquals(16_000, resampleLinear(FloatArray(44_100), 44_100, 16_000).size)
+        assertEquals(16_000, resampleLinear(FloatArray(32_000), 32_000, 16_000).size)
+    }
+
+    @Test
+    fun streamingResampler_chunkedOutputMatchesOneShot() {
+        val ramp = FloatArray(480) { (it % 37).toFloat() }
+        val oneShot = resampleLinear(ramp, 48_000, 16_000)
+
+        val resampler = StreamingResampler(48_000, 16_000)
+        val chunked = GrowableFloatArray()
+        var start = 0
+        while (start < ramp.size) {
+            val end = minOf(start + 7, ramp.size)
+            val chunk = ramp.copyOfRange(start, end)
+            resampler.process(chunk, chunk.size, chunked)
+            start = end
+        }
+
+        assertEquals(oneShot.toList(), chunked.toFloatArray().toList())
+    }
+
+    @Test
+    fun resampleLinear_samePassesThrough() {
+        val input = floatArrayOf(0.3f, -0.3f, 0.9f)
+        assertEquals(input.toList(), resampleLinear(input, 16_000, 16_000).toList())
+    }
+
+    // --- activity detection --------------------------------------------------
+
+    @Test
+    fun activeFrameMask_findsLoudRegionAndIgnoresSilence() {
+        // 40 quiet frames, 40 loud frames, 40 quiet frames.
+        val rms = FloatArray(120) { if (it in 40 until 80) 0.5f else 0.001f }
+        val mask = LocalWhisperEngine.activeFrameMask(rms)
+        assertTrue(mask.slice(40 until 80).all { it })
+        assertTrue(mask.slice(0 until 35).none { it })
+        assertTrue(mask.slice(85 until 120).none { it })
+    }
+
+    @Test
+    fun activeFrameMask_silentTrackHasNoActiveFrames() {
+        assertTrue(LocalWhisperEngine.activeFrameMask(FloatArray(50)).none { it })
+    }
+
+    @Test
+    fun activeFrameMask_bridgesShortGaps() {
+        val rms = FloatArray(60) { 0.5f }
+        for (i in 28 until 31) rms[i] = 0.0005f // 150 ms dip inside a loud passage
+        val mask = LocalWhisperEngine.activeFrameMask(rms)
+        assertTrue(mask.all { it })
+    }
+
+    @Test
+    fun activeSegmentsMs_returnsEmptyWhenTooLittleActivity() {
+        val mask = BooleanArray(10).also { it[3] = true; it[4] = true } // ~100 ms active
+        assertTrue(LocalWhisperEngine.activeSegmentsMs(mask, 50, 10_000L).isEmpty())
+    }
+
+    // --- word alignment ------------------------------------------------------
+
+    private fun words(count: Int, pause: Double = 0.0) =
+        List(count) { LocalWhisperEngine.AlignableWord("w$it", 4.0, pause) }
+
+    @Test
+    fun alignWords_spreadsEvenlyOverASingleSegment() {
+        val timings = LocalWhisperEngine.alignWordsToSegments(words(4), listOf(0L..4000L), 5000L)
+        assertEquals(listOf(0L, 1000L, 2000L, 3000L), timings.map { it.startTimeMs })
+        assertEquals(listOf(1000L, 2000L, 3000L, 4000L), timings.map { it.endTimeMs })
+    }
+
+    @Test
+    fun alignWords_skipsInstrumentalGapsAndNeverSpansThem() {
+        val timings = LocalWhisperEngine.alignWordsToSegments(
+            words(4),
+            listOf(0L..2000L, 5000L..7000L),
+            8000L
+        )
+        assertEquals(listOf(0L, 1000L, 5000L, 6000L), timings.map { it.startTimeMs })
+        // No word may stay highlighted across the 2000-5000 ms gap.
+        assertTrue(timings.none { it.startTimeMs < 2000L && it.endTimeMs > 2000L })
+    }
+
+    @Test
+    fun alignWords_fallsBackToWholeTrackWithoutSegments() {
+        val timings = LocalWhisperEngine.alignWordsToSegments(words(3), emptyList(), 10_000L)
+        assertEquals(500L, timings.first().startTimeMs)
+        assertEquals(9500L, timings.last().endTimeMs)
+    }
+
+    @Test
+    fun alignWords_pauseAfterLineAddsBreathingRoom() {
+        val timings = LocalWhisperEngine.alignWordsToSegments(
+            listOf(
+                LocalWhisperEngine.AlignableWord("a", 4.0, 4.0),
+                LocalWhisperEngine.AlignableWord("b", 4.0, 0.0)
+            ),
+            listOf(0L..12_000L),
+            12_000L
+        )
+        assertEquals(0L, timings[0].startTimeMs)
+        assertEquals(4000L, timings[0].endTimeMs)
+        assertEquals(8000L, timings[1].startTimeMs)
+    }
+
+    @Test
+    fun alignWords_timingsAreOrderedAndNeverOverlap() {
+        val timings = LocalWhisperEngine.alignWordsToSegments(
+            words(25, pause = 1.5),
+            listOf(300L..9000L, 12_000L..20_000L, 21_000L..30_000L),
+            31_000L
+        )
+        timings.forEach { assertTrue(it.endTimeMs > it.startTimeMs) }
+        timings.zipWithNext().forEach { (a, b) -> assertTrue(b.startTimeMs >= a.endTimeMs) }
+    }
+
+    // --- lyric parsing -------------------------------------------------------
+
+    @Test
+    fun extractAlignableWords_skipsSectionTagsAndAddsPauses() {
+        val lyrics = "[Verse 1]\nHello there\nfriend\n\n[Chorus]\nLa la"
+        val result = LocalWhisperEngine.extractAlignableWords(lyrics)
+
+        assertEquals(listOf("Hello", "there", "friend", "La", "la"), result.map { it.display })
+        // "friend" ends a line AND precedes a section tag -> longest pause.
+        val friend = result[2]
+        val there = result[1]
+        assertTrue(friend.pauseAfter > there.pauseAfter)
+        assertEquals(0.0, result[0].pauseAfter, 0.0)
+    }
+
+    @Test
+    fun extractAlignableWords_handlesArabicLyrics() {
+        val result = LocalWhisperEngine.extractAlignableWords("[مقطع]\nيا ليل يا عين")
+        assertEquals(listOf("يا", "ليل", "يا", "عين"), result.map { it.display })
+    }
+}
diff --git a/docs/free_ai_architecture.md b/docs/free_ai_architecture.md
new file mode 100644
index 0000000..5009727
--- /dev/null
+++ b/docs/free_ai_architecture.md
@@ -0,0 +1,58 @@
+# خطة ذكاء اصطناعي محلي قليل التكلفة لـ Melodia
+
+تاريخ التحقق: 6 نوفمبر 2026.
+
+## حالة التنفيذ الحالية في هذا الفرع
+
+- دُمج موفر Gemini Nano المحلي لكتابة الكلمات وتنقيح المطالبات والقوافي والمشاعر، مع فحص حالة AICore وتنزيل النموذج عند الحاجة؛ يعمل فقط على أجهزة مدعومة.
+- أصبح اختيار Nano هو الافتراضي للتثبيتات الجديدة. توليد الأغلفة السحابي معطّل حاليًا ويستخدم التطبيق الرسم الإجرائي المحلي.
+- رفع الصوت إلى Gemini أصبح متوقفًا افتراضيًا ويتطلب تفعيل إعداد صريح؛ محرك Whisper المحلي وتوليد الصور المحلي بنموذج diffusion لم يُدمجا بعد.
+- أُصلح Unix Gradle wrapper وأصبح Gradle 9.3.1 يبدأ؛ لم يكتمل تجميع Android أو الاختبارات لأن Android SDK/NDK غير مثبتين في بيئة التطوير الحالية.
+
+## الخلاصة التقنية
+
+لا توجد خدمة واحدة تضمن توليد كلمات وصور ومزامنة دقيقة مجانًا بلا حدود وعلى كل هاتف. الأنسب إذا كان المقصود «لا رسوم استخدام API» هو جعل التطبيق **محليًا أولًا**: يكتب النص على الجهاز عند توافر نموذج محلي، ويفرّغ الصوت محليًا، ويولّد غلافًا محليًا عند غياب نموذج الصور. يتطلب ذلك تنزيل بعض النماذج، مساحة تخزين، جهازًا مناسبًا، وقد يكون أبطأ من السحابة.
+
+## المسارات المقترحة
+
+### كتابة الكلمات
+
+على الهواتف المتوافقة، يمكن دمج ML Kit Prompt API مع Gemini Nano. يعمل الاستدلال على الجهاز ولا يفرض تكلفة خادم لكل طلب، لكن توفره يعتمد على دعم الجهاز ووجود/تنزيل النموذج. تذكر الوثائق أن الإدخال أقل من 4000 token، وتحذر من المخرجات الطويلة جدًا ومن حصة استخدام داخل التطبيق؛ لذلك يجب توفير fallback عند `UNAVAILABLE` أو انتهاء الحصة [1][2].
+
+للتغطية الأوسع، يمكن إدماج LiteRT-LM وتشغيل نموذج لغوي محلي يحمّله المستخدم داخل التطبيق. توثّق Google واجهة Kotlin وملفات `.litertlm`، وتوضح أن تهيئة النموذج قد تستغرق عدة ثوانٍ وأن الأداء يعتمد على المعالج/المسرّع وذاكرة الهاتف [3]. هذا خيار قابل للتشغيل دون مفتاح API بعد تثبيت النموذج، لكنه يحتاج اختيار نموذج مناسب واختبار الأجهزة واللغة العربية.
+
+### صور الأغلفة
+
+توليد الصور السحابي عبر نموذج Gemini الحالي ليس خيارًا مضمون المجانية. تسعير Google يذكر سعرًا للصورة في نماذج Gemini image ولا يضع لها free tier في النماذج الحديثة المذكورة [4]. لذا ينبغي ألا يُستدعى هذا المسار افتراضيًا إذا كان منع أي تكلفة هدفًا أساسيًا.
+
+لإنشاء صور مولدة فعلًا دون رسوم لكل طلب، يوجد MediaPipe Image Generator على Android. يتطلب نموذج diffusion متوافقًا مع Stable Diffusion v1.5 بصيغة MediaPipe المحوّلة، ويمكن تشغيل التوليد على الجهاز. توثّق Google هذا كمسار تجريبي؛ عينة Codelab تتطلب جهازًا بذاكرة 8 GB على الأقل، وتشير الوثائق إلى أن النموذج يجب تحويله وتجهيزه محليًا قبل تهيئة المكتبة [5][6][10]. عمليًا يجب اختبار السرعة والذاكرة وتنزيل النموذج الموافق مع مراعاة رخصته. إلى أن يتوفر نموذج محلي، يستطيع مولّد Melodia الإجرائي الموجود إعطاء غلاف فوري مجاني، لكنه فن مولّد بالقواعد وليس نموذج ذكاء اصطناعي توليدي.
+
+### أغاني المستخدم المحلية والتفريغ
+
+الملفات المحلية يجب أن تبقى على الهاتف. يمكن تشغيل whisper.cpp محليًا عبر NDK؛ المستودع الرسمي يذكر دعم Android والترخيص MIT لمكوّن البرنامج، ويوفر مثال Android. نماذج Whisper التي يذكرها المستودع تتراوح تقريبًا من 75 MiB لنموذج tiny إلى 466 MiB لـ small، مع ذاكرة تشغيل أعلى من حجم الملف [7][8]. يجب إضافة تنزيل اختياري للنموذج وقياس الذاكرة والسرعة. Whisper محرك تفريغ كلام وليس ضمانًا لاستخراج كلمات الغناء بدقة، لذا ينبغي عرض النص للمراجعة.
+
+محاذاة النص لا تساوي التفريغ: توقيت الصوت الحالي في Melodia تحليل تقريبي لطاقة الصوت وتقسيماته، وقد يحتسب الآلات الموسيقية ضمن المقاطع النشطة. الخطوة العملية هي إظهار أزمنة Whisper/المقاطع الصوتية كبداية قابلة للتعديل، ثم تحسين المحاذاة لاحقًا بموديل forced-alignment مناسب للغناء إن توفر. لا ينبغي الادعاء بأنها مزامنة دقيقة قبل اختبارها على أغانٍ فعلية.
+
+## ملاحظة عن الخيارات السحابية الموجودة
+
+تُظهر صفحة Hugging Face الرسمية أن مستخدمي الحساب المجاني لا يحصلون على رصيد Inference Providers شهري؛ يلزم شراء رصيد أو الاشتراك في PRO [9]. كما تذكر صفحة Gemini الرسمية توفر free tiers لبعض نماذج النص والصوت بحدود وحصص، لكنها لا تعني استخدامًا غير محدود، وقد تتغير الحصص والأسعار [4]. لذلك أبقيها اختيارًا اختياريًا فقط، لا أساسًا لوعد «مجاني بالكامل».
+
+## الخطوات التالية
+
+1. دمج Whisper.cpp عبر NDK مع تنزيل نموذج اختياري واختبار تفريغ الأغاني العربية على ملفات حقيقية؛ عدم الادعاء بالدقة قبل مراجعة النتائج.
+2. بعد معرفة الهواتف المستهدفة، إضافة MediaPipe Image Generator وتنزيل نموذج Stable Diffusion v1.5 متوافق ومحَوّل صراحة؛ الإبقاء على الغلاف الإجرائي كخيار خفيف للأجهزة الأخرى.
+3. إذا كان Gemini Nano غير مدعوم على نطاق واسع من الهواتف المستهدفة، تقييم LiteRT-LM ونموذج محلي بديل مع تنزيل المستخدم للنموذج.
+4. تحسين التوقيتات بخوارزمية محاذاة محلية قابلة للتعديل واختبارات على لهجات عربية وغناء وموسيقى صاخبة.
