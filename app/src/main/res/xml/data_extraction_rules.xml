<?xml version="1.0" encoding="utf-8"?>
<!-- Rules for Android 12+ (android:dataExtractionRules). See backup_rules.xml for the reasoning. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_prefs.xml" />
        <exclude domain="database" path="melodia_database-wal" />
        <exclude domain="database" path="melodia_database-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_prefs.xml" />
        <exclude domain="database" path="melodia_database-wal" />
        <exclude domain="database" path="melodia_database-shm" />
    </device-transfer>
</data-extraction-rules>
