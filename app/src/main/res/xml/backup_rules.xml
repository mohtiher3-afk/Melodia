<?xml version="1.0" encoding="utf-8"?>
<!--
    Rules for Android 11 and lower (android:fullBackupContent).
    The encrypted prefs are protected by a Keystore key that is not restored on a new device,
    so restoring the file would make it unreadable. Keep it out of backups.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="secure_prefs.xml" />
    <exclude domain="database" path="melodia_database-wal" />
    <exclude domain="database" path="melodia_database-shm" />
</full-backup-content>
